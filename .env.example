# AI Provider Configuration
# Choose one: watsonx (IBM Granite), qwen (Alibaba Qwen), or anthropic (Claude-compatible)
AI_PROVIDER=qwen

# Alibaba Qwen / DashScope (use when AI_PROVIDER=qwen)
# Reusing credentials from yieldscout project
DASHSCOPE_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-plus

# IBM watsonx.ai (use when AI_PROVIDER=watsonx)
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct

# Anthropic (use when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_BASE_URL=https://api.anthropic.com  # optional
# AI_MODEL=claude-sonnet-4-6  # optional
